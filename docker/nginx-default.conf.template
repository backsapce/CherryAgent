# WebSocket-capable hop-by-hop headers. Without the Upgrade/Connection pass-
# through the agent handshake dies at 400/502 instead of the 101 switch.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Docker's embedded DNS. Resolving the agent upstream lazily (via the
  # $agent_upstream variable below) keeps nginx starting and serving the SPA
  # even when no Agent Node exists yet; an unreachable upstream returns 502
  # per request instead of an [emerg] host-not-found at boot.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Same-origin proxy to the Agent Node, mirroring the Vite dev proxy
  # (vite.config.js). The browser resolves an empty/explicit-loopback agent
  # URL to <page-origin>/agent/ws (src/models/agentConnection.js), so without
  # this block the collapse lands on the SPA fallback and the WebSocket never
  # connects. AGENT_UPSTREAM is substituted at container start from the env.
  location /agent/ {
    set $agent_upstream ${AGENT_UPSTREAM};
    proxy_pass http://$agent_upstream;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The agent connection is long-lived (client pings every 20s, background
    # runs idle for much longer); default 60s would drop it mid-run.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
