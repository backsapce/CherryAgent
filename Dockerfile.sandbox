FROM node:lts-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY src ./src
COPY bin ./bin

# Agent commands execute as the container user, and the documented setup bind-
# mounts the workspace; running as root leaves root-owned files on the host.
# The stock `node` user is uid/gid 1000 — the typical first (non-root) host
# user — so mounted files just work on default Linux hosts. For other uids,
# run with --user $(id -u):$(id -g) and make sure both mounted directories are
# writable by that user.
RUN mkdir -p /home/cherry /var/lib/cherry-sandbox \
  && chown -R node:node /home/cherry /var/lib/cherry-sandbox

ENV AGENT_PORT=3099
ENV AGENT_WORKING_DIR=/home/cherry
ENV AGENT_STATE_DIR=/var/lib/cherry-sandbox
# This image ships no frontend (dist/ is not copied), so the old
# http://localhost:3099 default could never satisfy a real browser origin.
# Default to the origins the documented self-host setup serves: the docker
# cherry-agent front on :3098 plus the Vite dev server. Override with
# -e AGENT_ALLOWED_ORIGINS=... for any other front origin.
ARG AGENT_ALLOWED_ORIGINS=http://localhost:3098,https://localhost:3098,http://localhost:5173,https://localhost:5173
ENV AGENT_ALLOWED_ORIGINS=$AGENT_ALLOWED_ORIGINS

USER node

EXPOSE 3099

WORKDIR /home/cherry

VOLUME ["/var/lib/cherry-sandbox"]

CMD ["node", "/app/server/agent.js"]
